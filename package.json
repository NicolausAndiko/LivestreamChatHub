{
  "name": "livestream-chat-hub",
  "productName": "Livestream Chat Hub",
  "version": "1.0.0",
  "description": "Multi-platform livestream chat hub and overlay.",
  "author": "ItsPacoyHere",
  "license": "ISC",
  "main": "main.js",
  "type": "commonjs",

  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable"
  },

  "keywords": [
    "livestream",
    "chat",
    "overlay",
    "youtube",
    "twitch",
    "electron"
  ],

  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6"
  },

  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "tmi.js": "^1.8.5",
    "youtubei.js": "^17.2.0"
  },

  "build": {
    "appId": "com.nicolaus.livestreamchathub",
    "productName": "Livestream Chat Hub",

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**"
    ],

    "asar": true,

    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico"
    },

    "portable": {
      "artifactName": "Livestream Chat Hub.exe"
    }
  }
}